# ─────────────────────────────────────────────────────────────────────────────
# .env.prod.example — CanvasSync production environment (Azure 2-VM cluster)
#
# The deploy workflow writes each VM's .env from GitHub secrets/variables; this
# file is a reference for what each value looks like. See docs/deploy-azure.md.
#
# VM topology:
#   App VM  (B2ats v2, public)  → caddy, http-backend, ws-backend, ai-worker
#   Data VM (B2pts v2, private) → redis, rabbitmq
#
# Managed services:
#   - Database → Azure Database for PostgreSQL Flexible Server (private access)
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
INTERNAL_SECRET=replace-with-output-of-openssl-rand-hex-32

# ── Database (Azure Postgres Flexible Server — private access) ───────────────
DATABASE_URL=postgresql://canvas:REPLACE_STRONG_PASSWORD@YOUR-SERVER.postgres.database.azure.com:5432/canvas_db?sslmode=require

# ── Redis (container on Data VM — private IP) ─────────────────────────────────
# Canvas uses keyPrefix "canvas:" in ioredis, so all keys are namespace-isolated.
REDIS_PASS=replace-with-output-of-openssl-rand-hex-24
REDIS_URL=redis://:REDIS_PASS@DATA_VM_PRIVATE_IP:6379

# ── RabbitMQ (container on Data VM — private IP) ──────────────────────────────
RABBITMQ_USER=canvas
RABBITMQ_PASS=replace-with-output-of-openssl-rand-hex-24
RABBITMQ_URL=amqp://canvas:RABBITMQ_PASS@DATA_VM_PRIVATE_IP:5672

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
WEB_APP_URL=https://canvassync.tech

# ── Email ─────────────────────────────────────────────────────────────────────
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
GMAIL_FROM_EMAIL=Canvas.io <your-email@gmail.com>

# ── HTTP rate limiting ────────────────────────────────────────────────────────
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_MAX_REQUESTS=120

# ── DB Resilience ─────────────────────────────────────────────────────────────
DB_RETRY_ATTEMPTS=3
DB_RETRY_BASE_DELAY_MS=75
DB_CIRCUIT_BREAKER_ENABLED=true
DB_CIRCUIT_FAILURE_THRESHOLD=5
DB_CIRCUIT_WINDOW_MS=60000
DB_CIRCUIT_OPEN_MS=30000
DB_CIRCUIT_HALF_OPEN_SUCCESS_THRESHOLD=2

# ── WebSocket ─────────────────────────────────────────────────────────────────
WS_ENABLE_DURABLE_QUEUE=true
WS_DEBUG_ERRORS=false

# ── AI Generation Queue ───────────────────────────────────────────────────────
RABBITMQ_AI_GENERATE_EXCHANGE=canvas.ai.generate
RABBITMQ_AI_GENERATE_QUEUE=canvas.ai.generate.jobs
RABBITMQ_AI_GENERATE_ROUTING_KEY=ai.generate

# ── AI Provider ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-real-gemini-api-key
GEMINI_MODEL_CANDIDATES=gemini-flash-latest,gemini-flash-lite-latest

# ── AI worker callback URL ────────────────────────────────────────────────────
# ai-worker POSTs results back to http-backend on the same compose network
# (hard-coded in docker-compose.prod.yml).
HTTP_BACKEND_INTERNAL_URL=http://http-backend:3001

# ── GHCR image pull (App VM) ─────────────────────────────────────
GITHUB_REPO=your-github-username/canvassync

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.canvassync.tech/api/v1/auth/google/callback
GH_CLIENT_ID=your_github_client_id
GH_CLIENT_SECRET=your_github_client_secret
GH_CALLBACK_URL=https://api.canvassync.tech/api/v1/auth/github/callback

# list of allowed CORS origins:
ALLOWED_ORIGINS=https://canvassync.tech

# Domain for shared cookies:
COOKIE_DOMAIN=.canvassync.tech

# GitHub Actions secrets/variables required by deploy.yml are listed at the top
# of .github/workflows/deploy.yml.

# Core
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/canvas
PORT=3001
WS_PORT=8081
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# Email Config
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
GMAIL_FROM_EMAIL=Canvas.io <your-email@gmail.com>
WEB_APP_URL=http://localhost:3000

# HTTP rate limiting
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_MAX_REQUESTS=120

# DB Resilience
DB_RETRY_ATTEMPTS=3
DB_RETRY_BASE_DELAY_MS=75
DB_CIRCUIT_BREAKER_ENABLED=true
DB_CIRCUIT_FAILURE_THRESHOLD=5
DB_CIRCUIT_WINDOW_MS=60000
DB_CIRCUIT_OPEN_MS=30000
DB_CIRCUIT_HALF_OPEN_SUCCESS_THRESHOLD=2

# AI Generation Queue
RABBITMQ_AI_GENERATE_EXCHANGE=canvas.ai.generate
RABBITMQ_AI_GENERATE_QUEUE=canvas.ai.generate.jobs
RABBITMQ_AI_GENERATE_ROUTING_KEY=ai.generate

# AI provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_CANDIDATES=gemini-flash-latest,gemini-flash-lite-latest

# Internal worker callback security
INTERNAL_SECRET=replace-with-a-random-internal-secret
HTTP_BACKEND_INTERNAL_URL=http://127.0.0.1:3001

#OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"
GH_CLIENT_ID="your_github_client_id"
GH_CLIENT_SECRET="your_github_client_secret"
GH_CALLBACK_URL="http://localhost:3001/api/v1/auth/github/callback"

# CORS & Auth
ALLOWED_ORIGINS="https://canvassync.tech"
COOKIE_DOMAIN=".canvassync.tech"
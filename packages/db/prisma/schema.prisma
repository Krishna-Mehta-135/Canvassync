// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  password        String?
  name            String
  handle          String?        @unique
  photo           String?
  tokenVersion    Int            @default(0)
  refreshTokenExp DateTime?
  rooms           Room[]
  roomMembers     RoomMember[]
  roomAccessRequests RoomAccessRequest[]
  sentChats       Chat[]         @relation("ChatSender")
  receivedChats   Chat[]         @relation("ChatRecipient")
  oauthAccounts   OAuthAccount[]
}

/// Stores one row per (provider, providerAccountId) pair so a user can
/// link GitHub and Google to the same Canvas account.
model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String   // "github" | "google"
  providerAccountId String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Room {
  id        Int      @id @default(autoincrement())
  slug      String
  createdAt DateTime @default(now())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  chats     Chat[]
  shapes    Shape[]
  snapshots RoomSnapshot[]
  members   RoomMember[]
  // Unguessable token for the read-only public view link; null = link disabled.
  publicToken String? @unique
  accessRequests RoomAccessRequest[]

  @@unique([adminId, slug])
}

enum ChatMessageType {
  GROUP
  DIRECT
  COMMENT
}

model RoomMember {
  id        Int      @id @default(autoincrement())
  roomId    Int
  userId    String
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RoomAccessRequest {
  id             Int                 @id @default(autoincrement())
  roomId         Int
  requesterId    String
  status         AccessRequestStatus @default(PENDING)
  createdAt      DateTime            @default(now())
  respondedAt    DateTime?
  decisionNote   String?
  room           Room                @relation(fields: [roomId], references: [id])
  requester      User                @relation(fields: [requesterId], references: [id])

  @@index([roomId, status])
  @@unique([roomId, requesterId])
}

model Chat {
  id          Int             @id @default(autoincrement())
  roomId      Int
  message     String
  messageType ChatMessageType @default(GROUP)
  userId      String
  recipientId String?
  shapeId     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  room        Room            @relation(fields: [roomId], references: [id])
  user        User            @relation("ChatSender", fields: [userId], references: [id])
  recipient   User?           @relation("ChatRecipient", fields: [recipientId], references: [id])

  @@index([roomId, messageType, createdAt])
  @@index([roomId, shapeId, createdAt])
  @@index([roomId, recipientId, createdAt])
}

model Shape {
  id        String   @id @default(uuid())
  roomId    Int
  type      String
  props     Json
  deleted   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id])
}

// Point-in-time copy of a room's canvas, recorded (throttled) as edits are
// persisted. Powers version history / time travel.
model RoomSnapshot {
  id         Int      @id @default(autoincrement())
  roomId     Int
  shapes     Json
  shapeCount Int
  createdAt  DateTime @default(now())
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}
